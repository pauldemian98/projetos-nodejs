// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  EXTERNO
  ESTAGIARIO
  ASSISTENTE_1
  ASSISTENTE_2
  ASSISTENTE_3
  ENCARREGADO
  GESTOR
}

enum ChamadoStatus {
  ABERTO
  EM_ANALISE
  AGUARDANDO_RESPOSTA
  AGUARDANDO_AVALIACAO
  PAUSADO
  RESOLVIDO
}

enum TarefaStatus {
  REQUISITOS
  NECESSITA_ETAPA_ANTERIOR
  EM_DESENVOLVIMENTO
  EM_TESTE
  CONCLUIDO
}

model User {
  id              String   @id @default(uuid())
  nome_completo   String
  email           String   @unique
  senha           String
  data_nascimento DateTime
  papel           Role
  ativo           Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  especialidades       EspecialidadeAgente[]
  chamadosSolicitados  Chamado[]             @relation("ChamadoSolicitante")
  chamadosSolicitadosOriginal Chamado[]      @relation("ChamadoOriginalSolicitante")
  chamadosResponsaveis Chamado[]             @relation("ChamadoResponsavel")
  comentarios          Comentario[]
  anexos               Anexo[]
  historicoChamados    HistoricoChamado[]
  apontamentosTempo    ApontamentoTempo[]
  avaliacoesGestor        AvaliacaoGestor[]
  avaliacoesSolicitante   AvaliacaoSolicitante[] @relation("AgenteAvaliacoes")
  avaliacoesRecebidas     AvaliacaoSolicitante[] @relation("UsuarioAvaliado")
  avaliacoesProjeto       AvaliacaoProjeto[]
  tarefas                 Tarefa[]              @relation("TarefaResponsavel")
  papeisProjeto           PapelProjeto[]
  premiacoesRecebidas     PremiacaoMensal[]     @relation("PremiacaoAgente")
  premiacoesDadas         PremiacaoMensal[]     @relation("PremiacaoGestor")
  subcategoriasResponsavel Subcategoria[]       @relation("SubcategoriaResponsavel")
}

model Categoria {
  id      String  @id @default(uuid())
  nome    String
  prefixo String?
  ativo   Boolean @default(true)
  cor     String  @default("#3b82f6")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  subcategorias Subcategoria[]
  agentes       EspecialidadeAgente[]
  chamados      Chamado[]
}

model Subcategoria {
  id            String  @id @default(uuid())
  nome          String
  ativo         Boolean @default(true)
  categoriaId   String
  responsavelId String?
  prefixo       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  responsavel User?     @relation("SubcategoriaResponsavel", fields: [responsavelId], references: [id])
  chamados    Chamado[]
}

model EspecialidadeAgente {
  id          String @id @default(uuid())
  usuarioId   String
  categoriaId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  usuario   User      @relation(fields: [usuarioId], references: [id])
  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@unique([usuarioId, categoriaId])
}

model ConfiguracaoSistema {
  id    String @id @default(uuid())
  chave String @unique
  valor Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chamado {
  id                         String        @id @default(uuid())
  codigo                     String?
  titulo                     String
  descricao                  String        @db.Text
  prioridade                 String
  link_reuniao               String?
  is_emergencia              Boolean       @default(false)
  is_alinhamento_interno     Boolean       @default(false)
  tempo_gasto_total_segundos Int           @default(0)
  status                     ChamadoStatus @default(ABERTO)

  solicitanteId  String
  solicitanteOriginalId String?
  responsavelId  String?
  categoriaId    String
  subcategoriaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  solicitante      User               @relation("ChamadoSolicitante", fields: [solicitanteId], references: [id])
  solicitanteOriginal User?           @relation("ChamadoOriginalSolicitante", fields: [solicitanteOriginalId], references: [id])
  responsavel      User?              @relation("ChamadoResponsavel", fields: [responsavelId], references: [id])
  categoria        Categoria          @relation(fields: [categoriaId], references: [id])
  subcategoria     Subcategoria?      @relation(fields: [subcategoriaId], references: [id])
  anexos           Anexo[]
  comentarios      Comentario[]

  historico        HistoricoChamado[]
  apontamentos     ApontamentoTempo[]
  avaliacao            AvaliacaoChamado?
  avaliacaoSolicitante AvaliacaoSolicitante?
  avaliacoesGestor     AvaliacaoGestor[]
}

model Anexo {
  id            String @id @default(uuid())
  url_arquivo   String
  nome_original String

  chamadoId String?
  tarefaId  String?
  projetoId String?
  usuarioId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  chamado Chamado? @relation(fields: [chamadoId], references: [id])
  tarefa  Tarefa?  @relation(fields: [tarefaId], references: [id])
  projeto Projeto? @relation(fields: [projetoId], references: [id])
  usuario User?    @relation(fields: [usuarioId], references: [id])
}

model Comentario {
  id         String  @id @default(uuid())
  texto      String  @db.Text
  is_interno Boolean @default(false)

  chamadoId String
  usuarioId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  chamado Chamado @relation(fields: [chamadoId], references: [id])
  usuario User    @relation(fields: [usuarioId], references: [id])
}

model HistoricoChamado {
  id             String  @id @default(uuid())
  campo_alterado String
  valor_antigo   String? @db.Text
  valor_novo     String? @db.Text

  chamadoId String
  usuarioId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  chamado Chamado @relation(fields: [chamadoId], references: [id])
  usuario User    @relation(fields: [usuarioId], references: [id])
}

model ApontamentoTempo {
  id              String    @id @default(uuid())
  inicio          DateTime
  fim             DateTime?
  segundos_gastos Int?

  usuarioId String
  chamadoId String?
  tarefaId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  usuario User     @relation(fields: [usuarioId], references: [id])
  chamado Chamado? @relation(fields: [chamadoId], references: [id])
  tarefa  Tarefa?  @relation(fields: [tarefaId], references: [id])
}

model AvaliacaoSolicitante {
  id               String @id @default(uuid())
  nota_comunicacao Int
  nota_retorno     Int

  chamadoId  String @unique
  agenteId   String
  avaliadoId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chamado  Chamado @relation(fields: [chamadoId], references: [id])
  agente   User    @relation(fields: [agenteId], references: [id], name: "AgenteAvaliacoes")
  avaliado User    @relation(fields: [avaliadoId], references: [id], name: "UsuarioAvaliado")
}

model AvaliacaoChamado {
  id              String  @id @default(uuid())
  nota_satisfacao Int
  comentario      String? @db.Text
  problema_resolvido Boolean @default(true)

  chamadoId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  chamado Chamado @relation(fields: [chamadoId], references: [id])
}

model AvaliacaoGestor {
  id            String  @id @default(uuid())
  nota          Int
  ponto_atencao String? @db.Text
  elogio        String? @db.Text

  chamadoId String
  gestorId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  chamado Chamado @relation(fields: [chamadoId], references: [id])
  gestor  User    @relation(fields: [gestorId], references: [id])
}

model AvaliacaoProjeto {
  id                    String @id @default(uuid())
  dificuldades_tecnicas String @db.Text
  comunicacao           String @db.Text

  projetoId String
  usuarioId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  projeto Projeto @relation(fields: [projetoId], references: [id])
  usuario User    @relation(fields: [usuarioId], references: [id])
}

model Projeto {
  id        String  @id @default(uuid())
  nome      String
  descricao String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  tarefas    Tarefa[]
  papeis     PapelProjeto[]
  avaliacoes AvaliacaoProjeto[]
  anexos     Anexo[]
}

model Tarefa {
  id                         String       @id @default(uuid())
  titulo                     String
  descricao                  String?      @db.Text
  tempo_gasto_total_segundos Int          @default(0)
  status                     TarefaStatus @default(REQUISITOS)

  projetoId     String
  responsavelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  projeto      Projeto            @relation(fields: [projetoId], references: [id])
  responsavel  User?              @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
  subtarefas   Subtarefa[]
  apontamentos ApontamentoTempo[]
  anexos       Anexo[]
}

model Subtarefa {
  id        String  @id @default(uuid())
  titulo    String
  descricao String? @db.Text
  concluida Boolean @default(false)

  tarefaId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  tarefa Tarefa @relation(fields: [tarefaId], references: [id])
}

model PapelProjeto {
  id     String @id @default(uuid())
  funcao String

  usuarioId String
  projetoId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  usuario User    @relation(fields: [usuarioId], references: [id])
  projeto Projeto @relation(fields: [projetoId], references: [id])

  @@unique([usuarioId, projetoId, funcao])
}

model PremiacaoMensal {
  id              String   @id @default(uuid())
  mes_referencia  String
  mensagem_elogio String   @db.Text
  agenteId        String
  gestorId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agente User @relation("PremiacaoAgente", fields: [agenteId], references: [id])
  gestor User @relation("PremiacaoGestor", fields: [gestorId], references: [id])
}

