# ===================================
# Piatec HelpDesk - .gitignore
# ===================================

# ---- Node Modules ----
node_modules/
backend/node_modules/
frontend/node_modules/

# ---- Variáveis de ambiente (SEGURANÇA) ----
.env
backend/.env
frontend/.env

# ---- Build / Dist ----
backend/dist/
frontend/dist/
frontend/dist-ssr/

# ---- Uploads (arquivos enviados pelos usuários) ----
backend/uploads/*
!backend/uploads/.gitkeep

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Prisma (gerado automaticamente) ----
backend/prisma/dev.db
backend/prisma/dev.db-journal

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Arquivos temporários / scratch ----
scratch_*.js
patch.js
scratch_warning.js
backend/scratch_*.js
backend/fix_chamados.js
backend/check_users.js
backend/last_error.json

# ---- TypeScript build info ----
*.tsbuildinfo

# ---- Local configs ----
*.local
